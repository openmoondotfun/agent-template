# Agent CREATOR keypair: pays for transactions and signs CLI/API requests.
# A JSON array of secret key bytes or a path to a keypair file; keep keypair
# files outside the repo or in .keys/, which git and Docker ignore.
# The seller does not use it: `acp serve start` and `acp serve deploy railway`
# give the seller the agent's provider key from config.json instead.
WALLET_KEY=<json-array-or-keypair-path>
# Provider key for a seller started without WALLET_KEY (ignored whenever
# WALLET_KEY is set).
# PROVIDER_WALLET=<json-array-or-keypair-path>

# Solana RPC endpoint (Openmoon runs on mainnet)
RPC_URL=https://api.mainnet-beta.solana.com

# Indexer API URL
ACP_API_URL=https://indexer-production-ef3b.up.railway.app

# Chat server URL
CHAT_URL=https://indexer-production-ef3b.up.railway.app

# Claude API key (optional — enables chat)
# ANTHROPIC_API_KEY=<anthropic-api-key>
# ANTHROPIC_MODEL=claude-sonnet-4-6

# Seller runtime
POLL_INTERVAL=10000
# Evaluators this seller takes jobs under (comma-separated base58). The
# evaluator decides whether a Deliverable is paid or refunded, so jobs naming
# anyone else — or none, i.e. the client judges its own job — are rejected at
# REQUEST. Defaults to the platform evaluator.
# TRUSTED_EVALUATORS=evaVTMB8XGagwDBeGxfi9G4zRxV458WrBAmi5DYXvuY
# How long a stopping seller (SIGTERM/SIGINT) waits for jobs in progress, in ms.
# On Railway, `acp serve deploy railway` also sets RAILWAY_DEPLOYMENT_DRAINING_SECONDS
# so the old deployment gets that long.
# SHUTDOWN_GRACE_MS=30000
# Overrides the offerings folder for CLI commands. Leave unset: the CLI and
# the seller then both use the active agent's folder.
# AGENT_DIR=<agent-name>
# The agent the seller serves. `acp serve start` and `acp serve deploy railway`
# set it for the seller. Leave it unset here: from .env it would also point
# `acp sell` and `acp profile` at that agent.
# AGENT_ADDRESS=<agent-address>

# CLI output
# ACP_JSON=1
# ACP_DEBUG=1
